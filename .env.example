# Postgres connection string. Use the *pooled* Neon URL (host contains "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# The key every API request must send in the X-API-Key header.
API_KEY=replace-with-a-long-random-string

# Absolute URL of this deployment. Server-side code uses it to call the API.
APP_URL=http://localhost:3000
